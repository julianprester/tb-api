[
  {
    "namespace": "httpServer",
    "functions": [
      {
        "name": "start",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "port",
            "type": "integer",
            "description": "Port to listen on"
          }
        ]
      },
      {
        "name": "stop",
        "type": "function",
        "async": true,
        "parameters": []
      },
      {
        "name": "refreshFolder",
        "type": "function",
        "async": true,
        "description": "Refresh a concrete IMAP folder and wait for completion. Local folders return an explicit no-op result.",
        "parameters": [
          {
            "name": "folderId",
            "type": "string",
            "description": "The resolved Thunderbird MailFolder ID"
          },
          {
            "name": "timeoutMs",
            "type": "integer",
            "minimum": 1,
            "maximum": 60000,
            "optional": true,
            "description": "Per-caller timeout in milliseconds (default 30000)"
          }
        ]
      },
      {
        "name": "sendResponse",
        "type": "function",
        "async": false,
        "parameters": [
          {
            "name": "requestId",
            "type": "string"
          },
          {
            "name": "statusCode",
            "type": "integer"
          },
          {
            "name": "body",
            "type": "string"
          }
        ]
      }
    ],
    "events": [
      {
        "name": "onRequest",
        "type": "function",
        "parameters": [
          {
            "name": "request",
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "method": { "type": "string" },
              "path": { "type": "string" },
              "queryString": { "type": "string" },
              "body": { "type": "string" }
            }
          }
        ]
      },
      {
        "name": "onSendInvitation",
        "type": "function",
        "description": "Fired when calendar invitations need to be sent",
        "parameters": [
          {
            "name": "invitation",
            "type": "object",
            "properties": {
              "recipients": { "type": "array", "items": { "type": "string" } },
              "subject": { "type": "string" },
              "icsContent": { "type": "string" },
              "organizerEmail": { "type": "string" },
              "eventTitle": { "type": "string" }
            }
          }
        ]
      }
    ]
  }
]
